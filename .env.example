# 本地开发环境变量（复制为 .env 后填写，.env 不提交到 Git）

# 会话签名密钥（本地首跑若不填，会自动生成并写回 .env）
SECRET_KEY=

# 数据库：本地默认 SQLite；Render 上由 render.yaml 自动注入 PostgreSQL
# DATABASE_URL=sqlite:///./app.db
# 腾讯云 SCF 云函数部署时设置（无持久盘，SQLite 存 /tmp 并自动快照到 COS）：
# DB_PATH=/tmp/app.db

# S3 兼容对象存储 —— 腾讯云 COS 示例（在 COS 控制台「密钥管理」获取密钥）
# S3_ENDPOINT_URL=https://cos.ap-guangzhou.myqcloud.com
# S3_REGION=ap-guangzhou
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=my-project-files

# 可选：桶为「公有读」时填桶的默认访问域名（如 https://bucket.cos.ap-guangzhou.myqcloud.com），
# 视频走固定公开地址可被缓存；不填则动态签发预签名地址
# S3_PUBLIC_BASE_URL=

# 可选：站点对外域名（Render 上通常无需填写，自动从请求头识别）
# SITE_BASE_URL=
