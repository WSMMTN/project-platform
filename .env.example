# 本地开发环境变量（复制为 .env 后填写，.env 不提交到 Git）

# 会话签名密钥（本地首跑若不填，会自动生成并写回 .env）
SECRET_KEY=

# 数据库：本地默认 SQLite；Render 上由 render.yaml 自动注入 PostgreSQL
# DATABASE_URL=sqlite:///./app.db

# Cloudflare R2（R2 -> 管理 R2 API 令牌 -> 创建，权限 Object Read & Write）
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=my-project-files

# 可选：绑定 R2 自定义域后填写（如 https://files.example.com），
# 填了之后视频/文件走公开固定地址，可被浏览器缓存；不填则动态签发预签名地址
# R2_PUBLIC_BASE_URL=

# 可选：站点对外域名（Render 上通常无需填写，自动从请求头识别）
# SITE_BASE_URL=
